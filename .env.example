# PostgreSQL
DATABASE_URL=postgresql+psycopg://hawkwatch:hawkwatch@localhost:5432/hawkwatch

# Object storage (MinIO locally, S3 in AWS)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=hawkwatch-videos
AWS_ACCESS_KEY_ID=hawkwatch
AWS_SECRET_ACCESS_KEY=hawkwatch-dev-secret
AWS_REGION=us-east-1

# Upload limits
MAX_UPLOAD_BYTES=524288000
SIGNED_URL_TTL_SECONDS=900

# Worker
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=3
WORKER_DEVICE=mps

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
